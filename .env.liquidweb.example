# ============================================================
# Kingdom Deliverance — Liquid Web production environment
# Copy to the server as:  /var/www/kdcuganda.org/.env.production
#   cp .env.liquidweb.example .env.production
# Never commit .env.production
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://kdcuganda.org
PORT=3005
NODE_ENV=production

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (required for scheduled jobs on Liquid Web) ---
# Same value used by deploy/liquidweb/cron-runner.sh
CRON_SECRET=
# Optional alias:
# DM_CRON_SECRET=

# --- AI ---
GEMINI_API_KEY=

# --- Cloudflare R2 (media uploads) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Google OAuth (optional until Analytics/YouTube connect) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta OAuth (optional until FB/IG publish) ---
META_APP_ID=
META_APP_SECRET=
# DM_TOKEN_ENCRYPTION_KEY=

# --- Queue / Redis (optional sermon worker) ---
REDIS_URL=redis://127.0.0.1:6379
ENABLE_QUEUE_PROCESSOR=false
OLLAMA_ENDPOINT=
OLLAMA_MODEL=mistral
WHISPER_MODEL=base
WORKER_CONCURRENCY=1

# --- Other ---
EXCHANGE_RATE_API_KEY=
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@bishopclimateministries
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
